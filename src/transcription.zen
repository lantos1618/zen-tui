// Inference sends typed messages to the result actor. A bounded pipe bridges
// that actor to AppKit's main thread; neither actor touches UI state.
Recognizer, NativeError = parakeet
Ptr, null_ptr = std.mem
str_at = std.text

Posix = c.bind("unistd.h", {
    pipe* = (descriptors: Ptr<i32>) i32
    // The header supplies ssize_t; C's result conversion maps -1 to usize.MAX.
    // Every count is bounded before use, so the sentinel cannot be a byte count.
    read* = (fd: i32, bytes: Ptr<u8>, count: usize) usize
    write* = (fd: i32, bytes: Ptr<u8>, count: usize) usize
    close* = (fd: i32) i32
})
Errors = c.bind("errno.h", { __error* = () Ptr<i32> })
PollFd = { fd: i32, events: i16, returned: i16 }
Polling = c.bind("poll.h", "poll", {
    ready* = (descriptors: Ptr<PollFd>, count: u32, timeout: i32) i32
})

MailboxError* = OpenFailed | ReadFailed | Closed
Transcript* = { success*: bool, text*: str, session*: usize, final*: bool, ends_capture*: bool, count*: usize }

// The UI admits one job until its complete reply arrives. The result actor
// writes that reply; rejected result admission uses the worker error fallback.
// A reply is one status byte, at most 4000 text bytes, then NUL.
// This macOS app relies on Darwin's pipe buffer holding the one 4002-byte reply
// during close/join. PIPE_BUF is an atomicity limit, not that buffer's capacity;
// a single writer plus partial-read framing does not require an atomic record.
write_all = (fd: i32, text: str) bool {
    offset ::= 0;
    good   ::= true;
    loop(good && offset < text.len, (h) {
        count = Posix.write(fd, text.ptr().offset(offset), text.len - offset);
        (count > 0 && count <= text.len - offset).match({
            true  => { offset = offset + count; },
            false => { good = count == usize.MAX && Errors.__error().read(
                0
            ) == 4; },
        });
    });
    good
}

write_reply = (fd: i32, success: bool, text: str) () {
    length ::= text.len;
    (length > 4000).then(() {
        length = 4000;
        loop(length > 0 && text.ptr().read(length) >= 128 && text.ptr().read(length) < 192, (h) {
            length = length - 1;
        });
    });
    status = success.match({true => "T", false => "E"});
    write_all(fd, status).then(() {
        write_all(fd, text.slice(0, length)).then(() { write_all(fd, "\0"); });
    });
}

// Serialize actor results for the main-thread UI. Message text is copied by
// the actor runtime, so the inference scratch arena can be released immediately.
Results = { output: i32 }
Results.impl(Actor, {
    deliver = (self :: @Self, ctx: Context, success: bool, text: str) {
        write_reply(self.output, success, text);
    }
})

reply = (results: Ref<Results>, fallback: i32, success: bool, text: str) () {
    results.deliver(success, text).match({
        Ok(_)  => (),
        Err(_) => write_reply(
            fallback,
            false,
            "Cannot enqueue transcription result."
        ),
    });
}

Worker = {
    results: Ref<Results>,
    fallback: i32,
    recognizer :: Res<Recognizer>,

}

Worker.impl(Actor, {
    transcribe = (self :: @Self, ctx: Context, model: str, gpu: i32, pcm: str, rate: i32) {
        scratch ::= ctx.env.mem.alloc();
        self.recognizer.match({
            None  => {
                Recognizer.open(scratch, model, gpu).match({
                    Ok(recognizer) => { self.recognizer = Ok(recognizer); },
                    Err(error)     => error.match({
                        NativeError(detail) => reply(
                            self.results,
                            self.fallback,
                            false,
                            detail.message.view()
                        ),
                        _                   => reply(
                            self.results,
                            self.fallback,
                            false,
                            "Cannot load Parakeet model."
                        ),
                    }),
                });
            },
            Ok(_) => (),
        });
        self.recognizer.match({
            None           => (),
            Ok(recognizer) => {
                // Actor message bytes are copied; copy again into f32-aligned
                // storage instead of assuming the packed str payload alignment.
                count = pcm.len / 4;
                scratch.realloc<f32>(null_ptr<f32>(), count).match({
                    Err(_)      => reply(
                        self.results,
                        self.fallback,
                        false,
                        "Cannot allocate audio buffer."
                    ),
                    Ok(samples) => {
                        samples.to<u8>().copy_from(pcm.ptr(), count * 4);
                        recognizer.transcribe(
                            scratch,
                            samples,
                            count,
                            rate
                        ).match({
                            Ok(text)   => reply(
                                self.results,
                                self.fallback,
                                true,
                                text.view()
                            ),
                            Err(error) => error.match({
                                NativeError(detail) => reply(
                                    self.results,
                                    self.fallback,
                                    false,
                                    detail.message.view()
                                ),
                                _                   => reply(
                                    self.results,
                                    self.fallback,
                                    false,
                                    "Parakeet transcription failed."
                                ),
                            }),
                        });
                    },
                });
            },
        });
    }

    stopped = (self :: @Self, ctx: Context) {
        self.recognizer.match({
            Ok(recognizer) => { owner ::= recognizer; owner.close(); },
            None           => (),
        });
        self.recognizer = None;
    }
})

// Single owning handle. Keep a alive through close(), and do not copy a live
// handle. close drains the worker: native inference does not support cancellation.
Transcriber* = {
    worker: Ref<Worker>,
    results: Ref<Results>,
    input :: i32,
    output :: i32,
    descriptor: Ptr<PollFd>,
    buffer: Ptr<u8>,
    used :: usize,
    busy* :: bool,
    inflight :: usize,
    inflight_final :: bool,
    inflight_end :: bool,
    inflight_count :: usize,

    open* = (env: Env, a: Alloc) Res<Transcriber, MailboxError
        | ActorStartError
        | AllocError> {
        descriptors = a.realloc<i32>(null_ptr<i32>(), 2).try();
        @scope.defer(() { a.free(descriptors); });
        buffer     = a.realloc<u8>(null_ptr<u8>(), 4096).try();
        descriptor = a.create<PollFd>().try();
        (Posix.pipe(descriptors) == 0).ensure(MailboxError.OpenFailed).try();
        input  = descriptors.read(0);
        output = descriptors.read(1);
        descriptor.write(0, PollFd(fd: input, events: 1, returned: 0));
        env.spawn(Results(output: output)).match({
            Err(error)  => { Posix.close(input); Posix.close(output); Err(error) },
            Ok(results) => env.spawn(Worker(
                results: results,
                fallback: output,
                recognizer: None
            )).match({
                Err(error) => {
                    results.stop();
                    results.join();
                    Posix.close(input);
                    Posix.close(output);
                    Err(error)
                },
                Ok(worker) => Ok(Transcriber(
                    worker: worker,
                    results: results,
                    input: input,
                    output: output,
                    descriptor: descriptor,
                    buffer: buffer,
                    used: 0,
                    busy: false,
                    inflight: 0,
                    inflight_final: true,
                    inflight_end: true,
                    inflight_count: 0
                )),
            }),
        })
    }

    // The first successful model/gpu configuration stays cached until close.
    submit* = (self :: @Self, model: str, gpu: i32, samples: Ptr<f32>, count: usize, rate: i32)
              Res<bool, ActorError> {
        (self.busy || self.input < 0 || model.len == 0 || samples.is_null() || count == 0 || count > 5760000).match({
            true  => Ok(false),
            false => {
                self.worker.transcribe(
                    model,
                    gpu,
                    str_at(samples.to<u8>(), count * 4),
                    rate
                ).try();
                self.used           = 0;
                self.busy           = true;
                self.inflight       = 0;
                self.inflight_final = true;
                self.inflight_end   = true;
                self.inflight_count = count;
                Ok(true)
            },
        })
    }

    snapshot* = (self :: @Self, model: str, gpu: i32, session: usize, samples: Ptr<f32>, count: usize, rate: i32, finish: bool)
            Res<bool, ActorError> {
        (self.busy || self.input < 0 || model.len == 0 || session == 0 || samples.is_null() || count == 0 || count > 480000).match({
            true  => Ok(false),
            false => {
                self.worker.transcribe(
                    model,
                    gpu,
                    str_at(samples.to<u8>(), count * 4),
                    rate
                ).try();
                self.used           = 0;
                self.busy           = true;
                self.inflight       = session;
                self.inflight_final = finish;
                self.inflight_end   = finish;
                self.inflight_count = count;
                Ok(true)
            },
        })
    }

    segment* = (self :: @Self, model: str, gpu: i32, session: usize, samples: Ptr<f32>, count: usize, rate: i32, finalize: bool, ends_capture: bool)
               Res<bool, ActorError> {
        accepted = self.snapshot(
            model,
            gpu,
            session,
            samples,
            count,
            rate,
            finalize
        ).try();
        accepted.then(() { self.inflight_end = ends_capture; });
        Ok(accepted)
    }

    // Returned text borrows this handle's buffer until the next submit/poll.
    poll* = (self :: @Self) Res<Res<Transcript>, MailboxError> {
        (!self.busy).match({
            true  => Ok(None),
            false => self.read_reply(),
        })
    }

    read_reply = (self :: @Self) Res<Res<Transcript>, MailboxError> {
        ready = Polling.ready(self.descriptor, 1, 0);
        (ready >= 0 || Errors.__error().read(0) == 4).ensure(MailboxError.ReadFailed).try();
        (ready <= 0).match({
            true  => Ok(None),
            false => {
                count = Posix.read(
                    self.input,
                    self.buffer.offset(self.used),
                    4096 - self.used
                );
                (count > 0 && count <= 4096 - self.used).ensure(
                    MailboxError.ReadFailed
                ).try();
                self.used = self.used + count;
                (self.buffer.read(self.used - 1) == 0).match({
                    false => {
                        (self.used < 4096).ensure(
                            MailboxError.ReadFailed
                        ).try();
                        Ok(None)
                    },
                    true  => {
                        self.busy = false;
                        Ok(Ok(Transcript(
                            success: self.buffer.read(0) != 'E',
                            text: str_at(self.buffer.offset(1), self.used - 2),
                            session: self.inflight,
                            final: self.inflight_final,
                            ends_capture: self.inflight_end,
                            count: self.inflight_count
                        )))
                    },
                })
            },
        })
    }

    close* = (self :: @Self) () {
        (self.input >= 0).then(() {
            self.worker.stop();
            self.worker.join();
            self.results.stop();
            self.results.join();
            Posix.close(self.input);
            Posix.close(self.output);
            self.input  = -1;
            self.output = -1;
            self.busy   = false;
        });
    }
}

// Main-thread admission state: native work has one in-flight message, no queued
// audio backlog. A new recording supersedes any previous session's reply.
Live* = {
    session* :: usize = 0,
    sent* :: usize = 0,
    finished* :: bool = false,
    failed* :: bool = false,

    observe* = (self :: @Self, session: usize) () {
        (self.session != session).then(() {
            self.session  = session;
            self.sent     = 0;
            self.finished = false;
            self.failed   = false;
        });
    }

    due* = (self: @Self, count: usize, active: bool, busy: bool) bool {
        self.session > 0 && !busy && !self.failed && count > 0 && count >= self.sent &&
            active.match({true => count - self.sent >= 16000, false => !self.finished})
    }

    accepted* = (self :: @Self, count: usize, active: bool) () {
        self.sent     = count;
        self.finished = !active;
    }

    // Quiet phrase boundaries after eight seconds; fifteen seconds is the
    // hard bounded-context limit even if speech never pauses.
    finalize* = (self: @Self, count: usize, active: bool, quiet: bool) bool {
        !active || count >= 240000 || (count >= 128000 && quiet)
    }

    segment_count* = (self: @Self, count: usize) usize {
        (count > 240000).match({true => 240000, false => count})
    }

    due_segment* = (self: @Self, count: usize, active: bool, busy: bool, quiet: bool) bool {
        self.due(count, active, busy) || (self.session > 0 && !busy && !self.failed && !self.finished && count > 0 && self.finalize(count, active, quiet))
    }

    accepted_segment* = (self :: @Self, count: usize, active: bool) () {
        self.accepted(count, active);
    }

    // Call only after a successful current-session final reply AND exact
    // prefix removal. Any tail that arrived while decoding stays pending.
    committed* = (self :: @Self, session: usize, remaining: usize, active: bool) bool {
        self.current(session).match({
            false => false,
            true  => { self.sent = 0; self.finished = !active && remaining == 0; true },
        })
    }

    current* = (self: @Self, session: usize) bool { self.session == session }

    fail* = (self :: @Self) () { self.failed = true; }
}

quiet_tail* = (samples: Ptr<f32>, count: usize) bool {
    (count < 4800 || samples.is_null()).match({
        true  => false,
        false => {
            energy ::= 0.0;
            Range(count - 4800, count).loop((i) {
                value  = samples.read(i).to_f64();
                energy = energy + value * value;
            });
            energy / 4800.0 < 0.00001
        },
    })
}

// Bounded main-thread display history, not a durable transcript. The buffer
// never grows; scratch combinations are released at the end of a UI tick.
History* = {
    bytes: Ptr<u8>,
    used :: usize,
    trimmed :: bool,

    open* = (a: Alloc) Res<History, AllocError> {
        Ok(History(
            bytes: a.realloc<u8>(null_ptr<u8>(), 3500).try(),
            used: 0,
            trimmed: false
        ))
    }
    reset* = (self :: @Self) () { self.used = 0; self.trimmed = false; }
    view* = (self: @Self) str { str_at(self.bytes, self.used) }

    commit* = (self :: @Self, a: Alloc, text: str) Res<(), AllocError> {
        combined     = a.String(
            "{}{}{}",
            self.view(),
            (self.used > 0 && text.len > 0).match({true => " ", false => ""}),
            text
        ).try();
        tail         = recent(combined.view(), 3500);
        self.trimmed = self.trimmed || tail.len < combined.len();
        self.bytes.copy_from(tail.ptr(), tail.len);
        self.used = tail.len;
        Ok(())
    }

    render* = (self: @Self, a: Alloc, partial: str) Res<String, AllocError> {
        combined = a.String(
            "{}{}{}",
            self.view(),
            (self.used > 0 && partial.len > 0).match({true => " ",false => ""}),
            partial
        ).try();
        tail     = recent(combined.view(), 3500);
        result ::= a.String().try();
        (self.trimmed || tail.len < combined.len()).then(() {
            result.add("[Earlier text omitted]\n").try();
        });
        result.add(tail).try();
        Ok(result)
    }
}

recent = (text: str, limit: usize) str {
    start ::= (text.len > limit).match({true => text.len - limit,false => 0});
    loop(
        start < text.len && text.ptr().read(start) >= 128 && text.ptr().read(start) < 192,
        (h) { start = start + 1; }
    );
    text.slice(start, text.len)
}

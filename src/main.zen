App, Config = macos
Transcriber, Transcript, MailboxError, Live, quiet_tail = voice
History, recent_text = history
Editor, DocumentError = editor
load_model, configure_model = config
CAPTURE_OVERFLOW = macos.audio
Error = AllocError | ActorStartError | ActorError | MailboxError | DocumentError
Ptr, null_ptr = std.mem
analyze, voice_bands, smooth_levels = audio
Exporter, MAX_EXPORT_SAMPLES = export
Audio, decode = parakeet.wav

main = (env: Env) Res<i32, Error> {
    help = env.argv.find((arg) { arg.eq("--help") || arg.eq("-h") }).match({
        Ok(_) => true,
        None  => false,
    });
    help.match({
        true  => {
            println("Zen Code — a native workspace powered by zen-macos");
            println(
                "Usage: ZenCode [--file PATH] [--smoke] [--check-config] [--help]"
            );
            println(
                "--file edits an existing UTF-8 file: arrows, Cmd-Z undo, Cmd-S save; F2 dictates at cursor."
            );
            println("F2 records your voice. Enter speaks text. Escape closes.");
            println("--smoke renders a bounded number of frames and exits.");
            println(
                "--set-model /absolute/model.gguf saves the local model path for normal launches."
            );
            Ok(0)
        },
        false => env.argv.find((arg) { arg.eq("--check-config") }).match({
            Ok(_) => {
                a          = env.mem.alloc();
                configured = load_model(env, a).try().match({
                    Ok(path) => env.fs.exists(path) && !env.fs.is_dir(path),
                    None     => false,
                });
                println(
                    "Zen Code 0.2 · local model available: {}",
                    configured
                );
                Ok(configured.match({true => 0, false => 1}))
            },
            None  => env.argv.get(1).match({
                Ok(arg) => arg.eq("--set-model").match({
                    true  => {
                        a          = env.mem.alloc();
                        path       = env.argv.get(
                            2
                        ).match({Ok(value) => value, None => ""});
                        configured = configure_model(env, a, path).try();
                        Ok(configured.match({true => 0, false => 1}))
                    },
                    false => run(env),
                }),
                None    => run(env),
            }),
        }),
    })
}

run = (env: Env) Res<i32, Error> {
    arena       ::= env.mem.alloc();
    transcriber ::= Transcriber.open(env, arena).try();
    @scope.defer(() { transcriber.close(); });
    exporter: Res<Exporter> = env.var("ZEN_RECORDING_PATH").match({
        Ok(path) => Ok(Exporter.open(env, path, arena).try()),
        None     => None,
    });
    @scope.defer(
        () { exporter.match({Ok(value) => { owner ::= value; owner.close(); }, None => ()}); }
    );
    editor ::= Editor.open(env, arena).try();
    app    ::= App.configured(
        arena,
        Config(
            title: editor.enabled.match({true => editor.path(), false => "Zen Code"}),
            heading: "ZEN CODE",
            description: editor.enabled.match({true => "DOCUMENT / LOCAL VOICE\n\nArrows move · Cmd-Z undoes · Cmd-S saves · F2 dictates\nEscape closes · Cmd-Shift-Q discards unsaved edits", false => "LOCAL VOICE / METAL\n\nF2 starts/stops microphone capture.\nEnter speaks typed text · Escape closes."}),
            prompt: "you › ",
            greeting: "Welcome to Zen Code.",
            spectrum_label: "Voice FFT 80 Hz–4 kHz",
            input_tail_bytes: editor.enabled.match({true => 0, false => 600}),
            editable: editor.enabled
        )
    ).try();
    // Defers run in reverse registration order: close capture and native UI
    // before joining noncancellable inference, while arena remains alive.
    @scope.defer(() { app.close(); });
    model = load_model(env, arena).try();
    app.microphone.continuous(
        model.match({Ok(path) => path.len > 0, None => false})
    );
    history ::= History.open(arena).try();
    model.match({
        Ok(_) => app.set_notice(
            arena,
            "Parakeet local · live partials while recording with F2"
        ).try(),
        None  => app.set_notice(
            arena,
            "Transcription off · set ZEN_PARAKEET_MODEL"
        ).try(),
    });
    editor.enabled.then(() { editor.show(arena, app, "").try(); });
    (!app.begin(arena).try()).match({
        true  => Ok(1),
        false => {
            samples    = arena.realloc<f64>(null_ptr<f64>(), 1024).try();
            real       = arena.realloc<f64>(null_ptr<f64>(), 1024).try();
            imaginary  = arena.realloc<f64>(null_ptr<f64>(), 1024).try();
            magnitudes = arena.realloc<f64>(null_ptr<f64>(), 513).try();
            levels     = arena.realloc<f64>(null_ptr<f64>(), 32).try();
            targets    = arena.realloc<f64>(null_ptr<f64>(), 32).try();
            Range(0, 32).loop((i) { levels.write(i, 0.0); targets.write(i, 0.0); });
            last_frame ::= env.clock.since_start().ns;
            smoke       = env.argv.find(
                (arg) { arg.eq("--smoke") }
            ).match({Ok(_) => true, None => false});
            voice_smoke = env.argv.find(
                (arg) { arg.eq("--voice-smoke") }
            ).match({Ok(_) => true, None => false});
            voice_ready     ::= false;
            voice_submitted ::= env.clock.since_start().ns;
            model_ready     ::= false;
            (!smoke).then(() {
                model.match({
                    Ok(path) => (path.len > 0).then(() {
                        app.allow_capture(false);
                        transcriber.prepare(path, 0).try();
                        app.set_notice(
                            arena,
                            "Loading and warming local model · microphone starts when ready"
                        ).try();
                    }),
                    None     => (),
                });
            });
            running ::= true;
            smoke_started = env.clock.since_start().ns;
            live             ::= Live();
            saved_generation ::= 0;
            overflow_shown   ::= false;
            export_failed    ::= false;
            loop(running && (!smoke || (app.frames < 60 && env.clock.since_start().ns - smoke_started < 30000000000)) && (!voice_smoke || (env.clock.since_start().ns - smoke_started < 30000000000 && !voice_ready)), (
                h
            ) {
                scratch ::= env.mem.alloc();
                app.microphone.active().match({
                    true  => {
                        app.microphone.samples(samples);
                        analyze(samples, real, imaginary, magnitudes, 1024);
                        voice_bands(magnitudes, 513, 16000, targets, 32);
                    },
                    false => Range(0, 32).loop((i) { targets.write(i, 0.0); }),
                });
                now = env.clock.since_start().ns;
                smooth_levels(
                    targets,
                    levels,
                    32,
                    (now - last_frame).to_i32().match({
                        Ok(ns) => ns.to_f64() / 1000000000.0,
                        // Smoothing snaps to target for gaps of one second or more.
                        None   => 1.0,
                    })
                );
                last_frame = now;
                app.spectrum(levels);
                running = app.tick(scratch).try();
                editor.enabled.then(() {
                    app.take_key().match({
                        Ok(key) => { running = editor.key(
                            env,
                            scratch,
                            app,
                            key
                        ).try() && running; },
                        None    => (),
                    });
                });
                (live.session != app.microphone.session()).then(
                    () { history.reset(); overflow_shown = false; export_failed = false; }
                );
                live.observe(app.microphone.session());
                (app.microphone.generation() != saved_generation).then(() {
                    saved_generation = app.microphone.generation();
                    model.match({
                        Ok(_) => (),
                        None  => {
                            recording = app.microphone.recording();
                            (recording.count > 0).then(
                                () { export_failed = !queue_segment(
                                    exporter,
                                    recording.data,
                                    recording.count,
                                    recording.rate
                                ) || export_failed; }
                            );
                        },
                    });
                });

                transcriber.poll().try().match({
                    Ok(reply) => reply.preparation.match({
                        true  => {
                            model_ready = reply.success;
                            app.allow_capture(reply.success);
                            reply.success.match({
                                true  => {
                                    app.set_notice(
                                        scratch,
                                        "Parakeet ready · F2 starts dictation"
                                    ).try();
                                    voice_smoke.then(() {
                                        voice_submitted = env.clock.since_start().ns;
                                        submit_fixture(
                                            env,
                                            scratch,
                                            transcriber,
                                            model
                                        ).try();
                                    });
                                },
                                false => {
                                    println(
                                        "Model preparation failed: {}",
                                        reply.text
                                    );
                                    app.set_notice(
                                        scratch,
                                        "Model preparation failed · check the configured path"
                                    ).try();
                                    voice_smoke.then(() { running = false; });
                                },
                            });
                        },
                        false => (voice_smoke || live.current(reply.session)).then(() {
                        reply_received = env.clock.since_start().ns;
                        reply.success.match({
                            true  => {
                                voice_ready = reply.text.len > 0;
                                voice_smoke.match({
                                    true  => {
                                        app.set_input(
                                            scratch,
                                            reply.text
                                        ).try();
                                        println("Transcript: {}", reply.text);
                                        println(
                                            "zen-code: warm submit-to-reply {} ms (includes actor delivery, inference and UI polling; excludes model preparation and capture)",
                                            (reply_received - voice_submitted) / 1000000
                                        );
                                    },
                                    false => {
                                        reply.final.then(() {
                                            recording = app.microphone.recording();
                                            (reply.count <= recording.count).match({
                                                false => { live.fail(); app.microphone.stop(); (); },
                                                true  => {
                                                    editor.enabled.match({
                                                        true  => (!editor.transcript(scratch, app, reply.text, true).try()).then(() { live.fail(); app.microphone.stop(); }),
                                                        false => history.commit(
                                                            scratch,
                                                            reply.text
                                                        ).try(),
                                                    });
                                                    (!live.failed).then(() {
                                                    export_failed = !queue_segment(
                                                        exporter,
                                                        recording.data,
                                                        reply.count,
                                                        recording.rate
                                                    ) || export_failed;
                                                    app.microphone.discard_prefix(
                                                        reply.count
                                                    ).match({
                                                        true  => { live.committed(
                                                            reply.session,
                                                            app.microphone.recording().count,
                                                            app.microphone.active()
                                                        ); },
                                                        false => { live.fail(); app.microphone.stop(); (); },
                                                    });
                                                    });
                                                    ();
                                                },
                                            });
                                        });
                                        editor.enabled.match({
                                            true  => (!reply.final).then(
                                                () { editor.transcript(
                                                    scratch,
                                                    app,
                                                    reply.text,
                                                    false
                                                ).try(); }
                                            ),
                                            false => {
                                        displayed = history.render(
                                            scratch,
                                            reply.final.match({true => "",false => reply.text})
                                        ).try();
                                        app.set_input(
                                            scratch,
                                            displayed.view()
                                        ).try();
                                            },
                                        });
                                    },
                                });
                                (!overflow_shown).then(() { app.set_notice(scratch,live.failed.match({
                                    true  => "Recording stopped · could not preserve its audio boundary",
                                    false => (live.finished || voice_smoke).match({
                                        true  => "Parakeet local · transcription ready",
                                        false => "Continuous dictation · text may revise until each phrase settles",
                                    }),
                                })).try(); });
                            },
                            false => {
                                live.fail();
                                app.microphone.stop();
                                println("Transcription failed: {}", reply.text);
                                app.set_notice(
                                    scratch,
                                    "Transcription failed · check the model path and runtime log"
                                ).try();
                            },
                        });
                    }),
                    }),
                    None      => (),
                });
                (running && !voice_smoke && model_ready).then(() {
                    recording = app.microphone.recording();
                    active    = app.microphone.active();
                    chosen    = live.segment_count(recording.count);
                    quiet     = !transcriber.busy && chosen >= 128000 && quiet_tail(
                        recording.data,
                        chosen
                    );
                    live.due_segment(recording.count, active, transcriber.busy, quiet).then(() {
                        finalize = live.finalize(chosen, active, quiet);
                        model.match({
                            Ok(path) => transcriber.segment(path, 0, live.session, recording.data, chosen, 16000, finalize, !active && chosen == recording.count).try().then(() {
                                live.accepted_segment(chosen, active);
                                (!overflow_shown).then(() { app.set_notice(scratch,active.match({
                                    true  => "Continuous dictation · updating local text…",
                                    false => "Parakeet local · finishing latest recording…",
                                })).try(); });
                            }),
                            None     => (),
                        });
                    });
                });
                (app.microphone.status() == CAPTURE_OVERFLOW && !overflow_shown).then(() {
                    app.set_notice(
                        scratch,
                        "Transcription fell behind · capture stopped; press F2 to retry"
                    ).try();
                    overflow_shown = true;
                });
                export_failed.then(
                    () { app.set_notice(
                        scratch,
                        "Recording export queue full or closed · dictation continues; check the runtime log"
                    ).try(); }
                );
            });
            println(
                "zen-code: {} Metal frames · display link {} · submit {} FPS · p95 {} ms · p99 {} ms",
                app.frames,
                app.display_link(),
                app.submission_fps(),
                app.interval_p95_ms(),
                app.interval_p99_ms()
            );
            Ok(
                (app.frames > 0 && (!smoke || app.frames >= 60) && (!voice_smoke || voice_ready)).match({true => 0, false => 1})
            )
        },
    })
}

// Export admission copies PCM; encoding and atomic publication run on its actor.
queue_segment = (
    exporter : Res<Exporter>,
    samples  : Ptr<f32>,
    count    : usize,
    rate     : u32
) bool {
    exporter.match({
        None       => true,
        Ok(writer) => writer.enqueue(samples, count, rate).match({
            Ok(_)  => true,
            Err(_) => { println(
                "Recording export refused: queue full, closed or invalid segment"
            ); false },
        }),
    })
}

// Fixture decoding stays outside the worker for explicit smoke tests only.
submit_fixture = (
    env         : Env,
    a           : Alloc,
    transcriber :: Transcriber,
    model       : Res<str>
) Res<(), Error> {
    env.var("ZEN_TRANSCRIBE_WAV").match({
        Ok(path) => env.fs.read(a, path).match({
            Ok(bytes) => decode(a, bytes.view()).match({
                Ok(audio) => model.match({
                    Ok(path) => { transcriber.submit(
                        path,
                        0,
                        audio.samples,
                        audio.count,
                        audio.rate
                    ).try(); },
                    None     => (),
                }),
                _         => (),
            }),
            _         => (),
        }),
        None     => (),
    });
    Ok(())
}

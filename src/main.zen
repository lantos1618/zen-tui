App, Config = macos
Transcriber, Transcript, MailboxError, Live, quiet_tail = voice
History, recent_text = history
load_model, configure_model = config
CAPTURE_OVERFLOW = macos.audio
Error = AllocError | ActorStartError | ActorError | MailboxError
Ptr, null_ptr = std.mem
analyze, voice_bands, smooth_levels, encode_wav = audio
Audio, decode = parakeet.wav
monotonic = macos.display

main = (env: Env) Res<i32, Error> {
    help = env.argv.find((arg) { arg.eq("--help") || arg.eq("-h") }).match({
        Ok(_) => true,
        None  => false,
    });
    help.match({
        true  => {
            println("Zen Code — a native workspace powered by zen-macos");
            println("Usage: ZenCode [--smoke] [--check-config] [--help]");
            println("F2 records your voice. Enter speaks text. Escape closes.");
            println("--smoke renders a bounded number of frames and exits.");
            println(
                "--set-model /absolute/model.gguf saves the local model path for normal launches."
            );
            Ok(0)
        },
        false => env.argv.find((arg) { arg.eq("--check-config") }).match({
            Ok(_) => {
                a          = env.mem.alloc();
                configured = load_model(env, a).try().match({
                    Ok(path) => env.fs.exists(path) && !env.fs.is_dir(path),
                    None     => false,
                });
                println(
                    "Zen Code 0.2 · local model available: {}",
                    configured
                );
                Ok(configured.match({true => 0, false => 1}))
            },
            None  => env.argv.get(1).match({
                Ok(arg) => arg.eq("--set-model").match({
                    true  => {
                        a          = env.mem.alloc();
                        path       = env.argv.get(
                            2
                        ).match({Ok(value) => value, None => ""});
                        configured = configure_model(env, a, path).try();
                        Ok(configured.match({true => 0, false => 1}))
                    },
                    false => run(env),
                }),
                None    => run(env),
            }),
        }),
    })
}

run = (env: Env) Res<i32, Error> {
    arena ::= env.mem.alloc();
    app   ::= App.configured(
        arena,
        Config(
            title: "Zen Code",
            heading: "ZEN CODE",
            description: "LOCAL VOICE / METAL\n\nF2 starts/stops microphone capture.\nEnter speaks typed text · Escape closes.",
            prompt: "you › ",
            greeting: "Welcome to Zen Code.",
            spectrum_label: "Voice FFT 80 Hz–4 kHz",
            input_tail_bytes: 600
        )
    ).try();
    @scope.defer(() { app.close(); });
    transcriber ::= Transcriber.open(env, arena).try();
    @scope.defer(() { transcriber.close(); });
    // Stop capture before waiting for any noncancellable inference on exit.
    @scope.defer(() { app.microphone.stop(); });
    model = load_model(env, arena).try();
    app.microphone.continuous(
        model.match({Ok(path) => path.len > 0, None => false})
    );
    history ::= History.open(arena).try();
    model.match({
        Ok(_) => app.set_notice(
            arena,
            "Parakeet local · live partials while recording with F2"
        ).try(),
        None  => app.set_notice(
            arena,
            "Transcription off · set ZEN_PARAKEET_MODEL"
        ).try(),
    });
    (!app.begin(arena).try()).match({
        true  => Ok(1),
        false => {
            samples    = arena.realloc<f64>(null_ptr<f64>(), 1024).try();
            real       = arena.realloc<f64>(null_ptr<f64>(), 1024).try();
            imaginary  = arena.realloc<f64>(null_ptr<f64>(), 1024).try();
            magnitudes = arena.realloc<f64>(null_ptr<f64>(), 513).try();
            levels     = arena.realloc<f64>(null_ptr<f64>(), 32).try();
            targets    = arena.realloc<f64>(null_ptr<f64>(), 32).try();
            Range(0, 32).loop((i) { levels.write(i, 0.0); targets.write(i, 0.0); });
            last_frame ::= monotonic();
            smoke       = env.argv.find(
                (arg) { arg.eq("--smoke") }
            ).match({Ok(_) => true, None => false});
            voice_smoke = env.argv.find(
                (arg) { arg.eq("--voice-smoke") }
            ).match({Ok(_) => true, None => false});
            voice_ready ::= false;
            voice_smoke.then(() {
                env.var("ZEN_TRANSCRIBE_WAV").match({
                    Ok(path) => env.fs.read(arena, path).match({
                        Ok(bytes) => decode(arena, bytes.view()).match({
                            Ok(audio) => model.match({
                                Ok(path) => { transcriber.submit(
                                    path,
                                    0,
                                    audio.samples,
                                    audio.count,
                                    audio.rate
                                ).try(); },
                                None     => (),
                            }),
                            _         => (),
                        }),
                        _         => (),
                    }),
                    None     => (),
                });
            });
            running          ::= true;
            ticks            ::= 0;
            live             ::= Live();
            saved_generation ::= 0;
            overflow_shown   ::= false;
            loop(running && (!smoke || ticks < 60) && (!voice_smoke || (ticks < 1800 && !voice_ready)), (
                h
            ) {
                scratch ::= env.mem.alloc();
                app.microphone.active().match({
                    true  => {
                        app.microphone.samples(samples);
                        analyze(samples, real, imaginary, magnitudes, 1024);
                        voice_bands(magnitudes, 513, 16000, targets, 32);
                    },
                    false => Range(0, 32).loop((i) { targets.write(i, 0.0); }),
                });
                now = monotonic();
                smooth_levels(targets, levels, 32, now - last_frame);
                last_frame = now;
                app.spectrum(levels);
                running = app.tick(scratch).try();
                (live.session != app.microphone.session()).then(
                    () { history.reset(); overflow_shown = false; }
                );
                live.observe(app.microphone.session());
                (app.microphone.generation() != saved_generation).then(() {
                    saved_generation = app.microphone.generation();
                    model.match({
                        Ok(_) => (),
                        None  => {
                            recording = app.microphone.recording();
                            (recording.count > 0).then(
                                () { save_segment(
                                    env,
                                    scratch,
                                    recording.data,
                                    recording.count,
                                    recording.rate
                                ); }
                            );
                        },
                    });
                });

                transcriber.poll().try().match({
                    Ok(reply) => (voice_smoke || live.current(reply.session)).then(() {
                        reply.success.match({
                            true  => {
                                voice_ready = reply.text.len > 0;
                                voice_smoke.match({
                                    true  => {
                                        app.set_input(
                                            scratch,
                                            reply.text
                                        ).try();
                                        println("Transcript: {}", reply.text);
                                    },
                                    false => {
                                        reply.final.then(() {
                                            recording = app.microphone.recording();
                                            (reply.count <= recording.count).match({
                                                false => { live.fail(); app.microphone.stop(); },
                                                true  => {
                                                    history.commit(
                                                        scratch,
                                                        reply.text
                                                    ).try();
                                                    save_segment(
                                                        env,
                                                        scratch,
                                                        recording.data,
                                                        reply.count,
                                                        recording.rate
                                                    );
                                                    app.microphone.discard_prefix(
                                                        reply.count
                                                    ).match({
                                                        true  => { live.committed(
                                                            reply.session,
                                                            app.microphone.recording().count,
                                                            app.microphone.active()
                                                        ); },
                                                        false => { live.fail(); app.microphone.stop(); },
                                                    });
                                                },
                                            });
                                        });
                                        displayed = history.render(
                                            scratch,
                                            reply.final.match({true => "",false => reply.text})
                                        ).try();
                                        app.set_input(
                                            scratch,
                                            displayed.view()
                                        ).try();
                                    },
                                });
                                (!overflow_shown).then(() { app.set_notice(scratch,live.failed.match({
                                    true  => "Recording stopped · could not preserve its audio boundary",
                                    false => (live.finished || voice_smoke).match({
                                        true  => "Parakeet local · transcription ready",
                                        false => "Continuous dictation · text may revise until each phrase settles",
                                    }),
                                })).try(); });
                            },
                            false => {
                                live.fail();
                                app.microphone.stop();
                                println("Transcription failed: {}", reply.text);
                                app.set_notice(
                                    scratch,
                                    "Transcription failed · check the model path and runtime log"
                                ).try();
                            },
                        });
                    }),
                    None      => (),
                });
                (running && !voice_smoke).then(() {
                    recording = app.microphone.recording();
                    active    = app.microphone.active();
                    chosen    = live.segment_count(recording.count);
                    quiet     = !transcriber.busy && chosen >= 128000 && quiet_tail(
                        recording.data,
                        chosen
                    );
                    live.due_segment(recording.count, active, transcriber.busy, quiet).then(() {
                        finalize = live.finalize(chosen, active, quiet);
                        model.match({
                            Ok(path) => transcriber.segment(path, 0, live.session, recording.data, chosen, 16000, finalize, !active && chosen == recording.count).try().then(() {
                                live.accepted_segment(chosen, active);
                                (!overflow_shown).then(() { app.set_notice(scratch,active.match({
                                    true  => "Continuous dictation · updating local text…",
                                    false => "Parakeet local · finishing latest recording…",
                                })).try(); });
                            }),
                            None     => (),
                        });
                    });
                });
                (app.microphone.status() == CAPTURE_OVERFLOW && !overflow_shown).then(() {
                    app.set_notice(
                        scratch,
                        "Transcription fell behind · capture stopped; press F2 to retry"
                    ).try();
                    overflow_shown = true;
                });
                ticks = ticks + 1;
            });
            println("zen-code: {} Metal frames", app.frames);
            Ok(
                (app.frames > 0 && (!voice_smoke || voice_ready)).match({true => 0, false => 1})
            )
        },
    })
}

// Explicit opt-in export overwrites the requested file with each completed
// segment, not a claim that an unbounded dictation session fits one WAV.
save_segment = (
    env     : Env,
    a       : Alloc,
    samples : Ptr<f32>,
    count   : usize,
    rate    : u32
) () {
    env.var("ZEN_RECORDING_PATH").match({
        None     => (),
        Ok(path) => encode_wav(a, samples, count, rate).match({
            Err(_)  => println("Could not encode recording segment"),
            Ok(wav) => env.fs.write(path, wav.view()).match({
                Ok(_)  => println(
                    "Saved completed recording segment to {}",
                    path
                ),
                Err(_) => println("Could not write recording segment"),
            }),
        }),
    });
}
